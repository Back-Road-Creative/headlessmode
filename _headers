/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP (A6 hardening, 2026-04-20; web fonts dropped 2026-07-17):
  #   - script-src: no 'unsafe-inline' / 'unsafe-eval'. Every script the
  #     templates load is same-origin and file-scoped: /js/ carries
  #     mermaid-loader and table-enhancements (site-wide, from head.html)
  #     plus quiet-corners, redactcam-demo and sun-track-demo (one per
  #     demo/dashboard layout); /vendor/ carries the two libraries the
  #     dashboard needs (leaflet, topojson-client), self-hosted rather than
  #     fetched. Tailwind runs at build time (PR #114). cdn.jsdelivr.net
  #     remains because the mermaid library is lazy-loaded on pages with
  #     ```mermaid fences.
  #   - style-src: 'unsafe-inline' is retained for the remaining `style="..."`
  #     attributes and the small per-shortcode inline styles. No web-font host:
  #     type is now the platform system stack, so fonts.googleapis.com is gone.
  #   - frame-src 'none': site embeds no iframes.
  #   - connect-src 'self': static site; no XHR/WebSocket to third parties.
  #   - font-src 'self': no third-party web fonts (system stack only).
  #   - img-src: 'self' data: — data: for small inline SVG assets.
  #   - form-action 'self': forms (if any) cannot POST off-domain.
  #   - base-uri 'self': locks down <base> injection.
  #   - object-src 'none': no Flash/plugins.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Quiet-corners data exports (~3.9MB total) regenerate quarterly. 4h browser
# TTL, then ETag revalidation (304 unless a regen shipped) — a new export is
# visible well within a day without re-downloading megabytes per page view.
/data/quiet-corners/*
  Cache-Control: public, max-age=14400

# Vendored libraries (unhashed filenames) change only on manual upgrade.
# 7-day TTL; an upgrade propagates within a week, ETag 304s in between.
/vendor/*
  Cache-Control: public, max-age=604800
# Quiet Corners Field Maps — GENERATED by scripts/qcm/gen-headers.mjs, do not hand-edit.
#
# ONE rule, for one map. The path is EXACT rather than a wildcard: Cloudflare
# applies every matching rule and joins a repeated header with a comma, which a
# browser enforces as the INTERSECTION of both policies, so an overlapping rule
# would quietly cut this one back rather than widen it.
#
# This rule only DETACHES the global same-origin policy ("! " has removed it on this
# path since 2026-04). The map's own policy is NOT a header: it is a <meta
# http-equiv="Content-Security-Policy"> that this same generator writes as the first
# child of <head> in the built page, from the same cspValue(), so it is not bound by
# the 2,000-character _headers line cap. `npm run csp:headroom` reports its length.
#
# A page with no rule here falls back to the global same-origin policy and can
# reach no map service at all — it fails closed, and loudly.
#
# 60 state origins; the policy is 2334 characters.

/quiet-corners/
  ! Content-Security-Policy
