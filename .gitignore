# Hugo defaults
public/
resources/_gen/
.hugo_build.lock

# OS defaults
.DS_Store
Thumbs.db

# Node/JS defaults
# No trailing slash on purpose: the PR-CI gate mirror creates `node_modules` as a
# SYMLINK into the canonical checkout when it runs in a worktree, and a
# `node_modules/` pattern matches directories only — the symlink stayed untracked
# and showed up in every `git add -A`. Without the slash both forms are ignored.
node_modules
npm-debug.log
yarn-error.log

# Built Tailwind CSS (regenerated by `npm run build:css` in CI and dev).
# Source of truth: src/css/main.css.
themes/headlessmode/static/css/tailwind.css

# Editor defaults
.vscode/
.idea/

# Workspace scratch. In the monorepo layout this path is a SYMLINK to
# ../../.data/projects/site-headlessmode; no trailing slash so the symlink is
# ignored too. Matches the sibling site-gomoveshift repo.
.data

verification_reports/

__pycache__/
scripts/.pytest_cache/
venv/
.venv/
social-output/
cookies.txt

# Prediction pipeline data (large, regenerable)
predictions-output/
database/*.db
*.bak
claude-phase-state.json
claude-phase-state.json.lock

# Generated per CI run from .pa11yci.json with a free port substituted in;
# the workflow's trap removes it, this covers an interrupted local run.
.pa11yci.run.json

# Lighthouse CI writes its reports here on every local `lhci` run. Under WSL it
# also drops one Chrome user-data directory per run into the repo root, named
# with the literal UNC path it failed to resolve — \\wsl.localhost\...\lighthouse.NNNN
# — plus an `undefined:` tree. The backslashes are real characters in those
# names, not separators, so the pattern escapes each one as \\.
.lighthouseci/
\\\\wsl.localhost*
undefined:/
.hugo-preview.pid
.hugo-preview.log
preview-shots-*/
.hugo-preview.*.pid
.hugo-preview.*.log

# htmltest's own OutputDir (log + refcache.json); CI persists this across
# runs via actions/cache in pr-ci.yml, but it stays untracked locally.
tmp/.htmltest/
